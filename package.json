{
  "name": "student-registration-cypress-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Online student registration system with Cypress UI and API automated tests",
  "scripts": {
    "start": "node backend/server.js",
    "test:unit": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=html node --test",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "cypress": "^14.5.0"
  },
  "allowScripts": {
    "cypress@14.5.4": true
  }
}
